{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sbs.digitalsilk.com/schema/sbs-style/1.0.json",
  "title": "SBS style profile (sbs-style/1.0)",
  "description": "One design language, as data. STYLE-CONSTITUTION.md defines what each permitted value means. Generated by npm run styles:build from shared/styles/schema.mjs, which is the authoritative validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "familyId",
    "name",
    "version",
    "status",
    "description",
    "philosophy",
    "polarity",
    "tags",
    "useCases",
    "industries",
    "palette",
    "brandMapping",
    "typography",
    "radius",
    "buttonStyle",
    "dials",
    "composition",
    "patternPreferences",
    "dos",
    "donts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sbs-style/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "familyId": {
      "type": "string",
      "enum": [
        "technology",
        "luxury",
        "editorial",
        "corporate",
        "commerce",
        "hospitality",
        "automotive-mobility",
        "health-wellness",
        "creative-culture",
        "experimental"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "validated",
        "visual-qa",
        "production"
      ],
      "description": "Only \"production\" appears in the strategist picker."
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400
    },
    "philosophy": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "polarity": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "description": "Whether the body canvas is lighter or darker than the ink."
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "useCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 60
      }
    },
    "industries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg",
        "ink",
        "accent",
        "soft",
        "dark"
      ],
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "soft": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "dark": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      }
    },
    "brandMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "accentOnly",
            "accentAndSurface",
            "full"
          ],
          "description": "How far the client brand may enter the palette."
        },
        "protectedRoles": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "bg",
              "ink",
              "accent",
              "soft",
              "dark"
            ]
          },
          "description": "Roles the brand may never take, whatever the brief says."
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "body",
        "scale",
        "displayCase",
        "displayTracking"
      ],
      "properties": {
        "display": {
          "type": "string",
          "enum": [
            "Inter",
            "Manrope",
            "DM Sans",
            "Space Grotesk",
            "Work Sans",
            "Barlow",
            "IBM Plex Mono",
            "Nunito Sans",
            "Lora",
            "Fraunces",
            "Cormorant Garamond",
            "Source Serif 4",
            "Libre Franklin",
            "Archivo Black"
          ]
        },
        "body": {
          "type": "string",
          "enum": [
            "Inter",
            "Manrope",
            "DM Sans",
            "Space Grotesk",
            "Work Sans",
            "Barlow",
            "IBM Plex Mono",
            "Nunito Sans",
            "Lora",
            "Fraunces",
            "Cormorant Garamond",
            "Source Serif 4",
            "Libre Franklin",
            "Archivo Black"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.35
        },
        "displayCase": {
          "type": "string",
          "enum": [
            "none",
            "upper"
          ]
        },
        "displayTracking": {
          "type": "number",
          "minimum": -0.05,
          "maximum": 0.24
        }
      }
    },
    "radius": {
      "type": "string",
      "pattern": "^\\d+px$"
    },
    "buttonStyle": {
      "type": "string",
      "enum": [
        "solid-shift",
        "sweep-fill",
        "offset-block",
        "pill-glow",
        "magnetic-arrow",
        "split-reveal",
        "corner-cut",
        "neon-trace",
        "depth-press",
        "ink-wipe"
      ]
    },
    "dials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density",
        "measure",
        "headline",
        "accent",
        "surface",
        "corner",
        "imagery",
        "motion",
        "expressiveness"
      ],
      "properties": {
        "density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "measure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "headline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "accent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "surface": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "corner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "imagery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "motion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "expressiveness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "All nine are required: an unset dial falls back to a neutral 50 and the style stops being a style on that axis."
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment",
        "containerBias",
        "mediaDominance",
        "surfaceTreatment",
        "asymmetry",
        "fullBleedBias"
      ],
      "properties": {
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "centered",
            "split",
            "asymmetric"
          ]
        },
        "containerBias": {
          "type": "string",
          "enum": [
            "full",
            "wide",
            "default",
            "alt"
          ]
        },
        "mediaDominance": {
          "type": "string",
          "enum": [
            "none",
            "supporting",
            "balanced",
            "dominant",
            "immersive"
          ]
        },
        "surfaceTreatment": {
          "type": "string",
          "enum": [
            "flat",
            "bordered",
            "raised",
            "layered",
            "glass"
          ]
        },
        "asymmetry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "fullBleedBias": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "patternPreferences": {
      "type": "object",
      "additionalProperties": false,
      "description": "Terms, not pattern ids: matched against the profile the ranker builds from each pattern catalogue entry, so a preference survives the catalogue growing.",
      "properties": {
        "prefer": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          }
        },
        "avoid": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          }
        },
        "byFamily": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {
            "enum": [
              "hero",
              "text",
              "logo",
              "stats",
              "split",
              "cards",
              "tabs",
              "timeline",
              "testimonial",
              "cta",
              "faq",
              "slider",
              "pricing",
              "gallery",
              "contact",
              "blog",
              "team",
              "accordion",
              "haccordion"
            ]
          },
          "patternProperties": {
            ".*": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "prefer": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40
                  }
                },
                "avoid": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40
                  }
                }
              }
            }
          }
        }
      }
    },
    "componentRecipes": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": [
          "hero",
          "text",
          "logo",
          "stats",
          "split",
          "cards",
          "tabs",
          "timeline",
          "testimonial",
          "cta",
          "faq",
          "slider",
          "pricing",
          "gallery",
          "contact",
          "blog",
          "team",
          "accordion",
          "haccordion"
        ]
      },
      "patternProperties": {
        ".*": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "string",
              "enum": [
                "full",
                "wide",
                "default",
                "alt"
              ]
            },
            "paddingTop": {
              "type": "string",
              "enum": [
                "none",
                "small",
                "default",
                "large"
              ]
            },
            "paddingBottom": {
              "type": "string",
              "enum": [
                "none",
                "small",
                "default",
                "large"
              ]
            },
            "inverted": {
              "type": "boolean"
            },
            "viewport": {
              "type": "string",
              "enum": [
                "",
                "fade-up",
                "fade-in-seq",
                "animate-headings"
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "columnsMobile": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "decoration": {
              "type": "string",
              "maxLength": 40,
              "description": "A motif id the pattern catalogue ships."
            },
            "decorationOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            }
          }
        }
      }
    },
    "dos": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 140
      }
    },
    "donts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 140
      }
    }
  }
}
