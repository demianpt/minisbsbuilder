{
  "name": "sbs-page-builder",
  "version": "2.9.0",
  "private": true,
  "description": "One SBS project, 50 production styles across 10 families, three independently editable concept workspaces, two interfaces over one engine.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:health": "node scripts/check-env.mjs --probe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "qa:concepts": "node scripts/qa-concepts.mjs",
    "styles:build": "node scripts/styles-build.mjs",
    "styles:validate": "node scripts/styles-build.mjs --no-docs",
    "migrate:legacy": "node scripts/extract-legacy-page.mjs",
    "test:bundle": "node scripts/test-project-bundle.mjs",
    "test:wordpress": "php tests/wordpress/importer-unit.php && php tests/wordpress/importer-contract.php",
    "test:handoff": "npm run test:bundle && npm run test:wordpress && npm run test:wordpress:catalog && node scripts/verify-against-theme.mjs",
    "test:wordpress:catalog": "php tests/wordpress/importer-catalog-sweep.php",
    "check:stock": "node scripts/check-shutterstock.mjs",
    "test:upgrade": "node scripts/qa-upgrades.mjs",
    "record:wordpress": "node scripts/record-wordpress-fixtures.mjs",
    "ingest:patterns": "node scripts/ingest-patterns.mjs",
    "clean:patterns": "node scripts/clean-patterns.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "sync:registry": "node scripts/sync-dst-registry.mjs",
    "verify:export": "npm run record:wordpress && node scripts/verify-against-theme.mjs",
    "build:deck": "node scripts/build-deck.mjs",
    "check:ollama": "node scripts/check-ollama.mjs",
    "predev:client": "node scripts/free-dev-port.mjs",
    "free:port": "node scripts/free-dev-port.mjs",
    "build:sample": "node scripts/test-project-bundle.mjs --deliver",
    "verify:catalog": "node scripts/verify-catalog-against-theme.mjs",
    "audit:coverage": "node scripts/audit-export-coverage.mjs",
    "audit:legibility": "node scripts/audit-pattern-legibility.mjs",
    "audit:legibility:pixels": "node scripts/audit-pattern-legibility-pixels.mjs",
    "qa:parity": "node scripts/qa-parity.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.54.1",
    "supertest": "^7.1.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  }
}
