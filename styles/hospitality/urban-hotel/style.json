{
  "schemaVersion": "sbs-style/1.0",
  "id": "urban-hotel",
  "familyId": "hospitality",
  "name": "Urban Hotel",
  "version": "1.0.0",
  "status": "production",
  "description": "City confidence: crisp neutrals, architectural photography and a tighter, more functional rhythm.",
  "philosophy": "A city guest is booking a base, not a retreat. Be handsome and efficient.",
  "polarity": "light",
  "tags": [
    "urban",
    "architectural",
    "crisp",
    "functional"
  ],
  "useCases": [
    "City hotel homepage",
    "Meetings and events page",
    "Location and transport page"
  ],
  "industries": [
    "hospitality",
    "hotels",
    "restaurants",
    "travel"
  ],
  "palette": {
    "bg": "#F7F7F5",
    "ink": "#16181A",
    "accent": "#3B4A63",
    "soft": "#E5E6E4",
    "dark": "#0F1113"
  },
  "brandMapping": {
    "strategy": "accentAndSurface",
    "protectedRoles": [
      "bg"
    ]
  },
  "typography": {
    "display": "Work Sans",
    "body": "Inter",
    "scale": 1.04,
    "displayCase": "none",
    "displayTracking": -0.01
  },
  "radius": "4px",
  "buttonStyle": "solid-shift",
  "dials": {
    "density": 44,
    "measure": 50,
    "headline": 54,
    "accent": 34,
    "surface": 40,
    "corner": 18,
    "imagery": 68,
    "motion": 24,
    "expressiveness": 34
  },
  "composition": {
    "alignment": "left",
    "containerBias": "wide",
    "mediaDominance": "dominant",
    "surfaceTreatment": "flat",
    "asymmetry": 18,
    "fullBleedBias": 42
  },
  "patternPreferences": {
    "prefer": [
      "large media",
      "full bleed",
      "gallery",
      "atmosphere",
      "architectural",
      "split",
      "grid"
    ],
    "avoid": [
      "table",
      "diagram",
      "dense",
      "ornament",
      "gradient"
    ],
    "byFamily": {
      "cards": {
        "prefer": [
          "three",
          "media"
        ],
        "avoid": []
      }
    }
  },
  "componentRecipes": {
    "hero": {
      "container": "full",
      "paddingTop": "none",
      "paddingBottom": "none",
      "inverted": true,
      "viewport": "fade-up"
    },
    "cards": {
      "container": "wide",
      "paddingTop": "default",
      "paddingBottom": "default",
      "columns": 3
    },
    "contact": {
      "container": "default",
      "paddingTop": "large",
      "paddingBottom": "large"
    }
  },
  "dos": [
    "Photograph the building and the street",
    "Make booking the obvious next step"
  ],
  "donts": [
    "Never bury the location",
    "Avoid resort-scale romanticism"
  ]
}
