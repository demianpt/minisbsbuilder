      "list",
      "faq",
      "split",
      "people",
      "large media",
      "rounded",
      "spacious"
    ],
    "avoid": [
      "brutal",
      "oversized",
      "table",
      "dense"
    ],
    "byFamily": {
      "cards": {
        "prefer": [
          "three",
          "rounded"
        ],
        "avoid": []
      }
    }
  },
  "componentRecipes": {
