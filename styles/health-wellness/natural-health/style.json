    "Nutrition programme page",
    "Practice and philosophy page"
  ],
  "industries": [
    "healthcare",
    "wellness",
    "clinics",
    "biotech"
  ],
  "palette": {
    "bg": "#F6F8F3",
    "ink": "#1D2620",
    "accent": "#4E8156",
    "soft": "#E3EBDF",
    "dark": "#141A17"
  },
  "brandMapping": {
    "strategy": "accentAndSurface",
    "protectedRoles": [
      "bg"
    ]
  },
  "typography": {
    "display": "Fraunces",
    "body": "Inter",
    "scale": 1.08,
    "displayCase": "none",
