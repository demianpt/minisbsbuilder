{
  "schemaVersion": "sbs-style/1.0",
  "id": "neo-brutalist",
  "familyId": "experimental",
  "name": "Neo Brutalist",
  "version": "1.0.0",
  "status": "production",
  "description": "Raw structure on show: black rules, hard shadows, unmodulated colour and no rounding at all.",
  "philosophy": "Honesty about the medium. Boxes are boxes, links look like links, nothing pretends to be a material it is not.",
  "polarity": "light",
  "tags": [
    "brutal",
    "flat",
    "hard-edge",
    "high-contrast"
  ],
  "useCases": [
    "Startup homepage with attitude",
    "Developer community page",
    "Product manifesto"
  ],
  "industries": [
    "technology",
    "culture",
    "media",
    "startups"
  ],
  "palette": {
    "bg": "#F5F3EA",
    "ink": "#0A0A0A",
    "accent": "#1F1FE0",
    "soft": "#E6E3D6",
    "dark": "#000000"
  },
  "brandMapping": {
    "strategy": "full",
    "protectedRoles": []
  },
  "typography": {
    "display": "Archivo Black",
    "body": "Barlow",
    "scale": 1.22,
    "displayCase": "upper",
    "displayTracking": -0.01
  },
  "radius": "0px",
  "buttonStyle": "offset-block",
  "dials": {
    "density": 62,
    "measure": 62,
    "headline": 88,
    "accent": 72,
    "surface": 92,
    "corner": 0,
    "imagery": 44,
    "motion": 12,
    "expressiveness": 90
  },
  "composition": {
    "alignment": "asymmetric",
    "containerBias": "wide",
    "mediaDominance": "supporting",
    "surfaceTreatment": "bordered",
    "asymmetry": 62,
    "fullBleedBias": 34
  },
  "patternPreferences": {
    "prefer": [
      "asymmetric",
      "oversized",
      "flat",
      "bordered",
      "grid",
      "list"
    ],
    "avoid": [
      "clear",
      "table",
      "rounded",
      "gradient",
      "glass",
      "photo overlay"
    ],
    "byFamily": {
      "cards": {
        "prefer": [
          "grid",
          "four"
        ],
        "avoid": []
      },
      "hero": {
        "prefer": [
          "text-dominant"
        ],
        "avoid": []
      }
    }
  },
  "componentRecipes": {
    "hero": {
      "container": "wide",
      "paddingTop": "large",
      "paddingBottom": "large",
      "viewport": ""
    },
    "cards": {
      "container": "wide",
      "paddingTop": "default",
      "paddingBottom": "default",
      "columns": 4
    },
    "text": {
      "container": "wide",
      "paddingTop": "default",
      "paddingBottom": "default"
    },
    "cta": {
      "container": "wide",
      "paddingTop": "large",
      "paddingBottom": "large",
      "inverted": true
    }
  },
  "dos": [
    "Show every border",
    "Let colour be unmodulated"
  ],
  "donts": [
    "Never round anything",
    "Avoid gradients and blur"
  ]
}
