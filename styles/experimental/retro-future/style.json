{
  "schemaVersion": "sbs-style/1.0",
  "id": "retro-future",
  "familyId": "experimental",
  "name": "Retro Future",
  "version": "1.0.0",
  "status": "production",
  "description": "Eighties optimism rebuilt: chrome-adjacent gradients, grid horizons and a saturated duotone.",
  "philosophy": "Nostalgia for a future that never arrived. Use its grammar without becoming a pastiche.",
  "polarity": "dark",
  "tags": [
    "retro",
    "gradient",
    "duotone",
    "dark"
  ],
  "useCases": [
    "Games or entertainment launch",
    "Music or event page",
    "Retro-brand campaign"
  ],
  "industries": [
    "technology",
    "culture",
    "media",
    "startups"
  ],
  "palette": {
    "bg": "#0E0A1F",
    "ink": "#F5EEFF",
    "accent": "#FF2D95",
    "soft": "#1E1440",
    "dark": "#070417"
  },
  "brandMapping": {
    "strategy": "full",
    "protectedRoles": []
  },
  "typography": {
    "display": "Space Grotesk",
    "body": "Work Sans",
    "scale": 1.2,
    "displayCase": "upper",
    "displayTracking": 0.06
  },
  "radius": "4px",
  "buttonStyle": "neon-trace",
  "dials": {
    "density": 46,
    "measure": 58,
    "headline": 82,
    "accent": 82,
    "surface": 40,
    "corner": 18,
    "imagery": 62,
    "motion": 74,
    "expressiveness": 92
  },
  "composition": {
    "alignment": "centered",
    "containerBias": "wide",
    "mediaDominance": "balanced",
    "surfaceTreatment": "layered",
    "asymmetry": 40,
    "fullBleedBias": 62
  },
  "patternPreferences": {
    "prefer": [
      "asymmetric",
      "oversized",
      "flat",
      "gradient",
      "overlay",
      "centered",
      "background media"
    ],
    "avoid": [
      "clear",
      "table",
      "bordered"
    ],
    "byFamily": {
      "hero": {
        "prefer": [
          "background media",
          "overlay"
        ],
        "avoid": []
      }
    }
  },
  "componentRecipes": {
    "hero": {
      "container": "full",
      "paddingTop": "none",
      "paddingBottom": "none",
      "inverted": true,
      "viewport": "animate-headings",
      "decoration": "dot-grid",
      "decorationOpacity": 0.16
    },
    "cards": {
      "container": "wide",
      "paddingTop": "large",
      "paddingBottom": "large",
      "inverted": true,
      "columns": 3
    },
    "stats": {
      "container": "default",
      "paddingTop": "large",
      "paddingBottom": "large",
      "inverted": true
    },
    "cta": {
      "container": "full",
      "paddingTop": "none",
      "paddingBottom": "none",
      "inverted": true
    }
  },
  "dos": [
    "Use the grid horizon once",
    "Keep the duotone consistent"
  ],
  "donts": [
    "Never add a third loud hue",
    "Avoid parody"
  ]
}
