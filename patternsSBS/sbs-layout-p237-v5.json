  "content": "<!-- wp:ds-blocks/dst-wrapper {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"dsPadding\":{\"top\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"},\"bottom\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"}},\"metadata\":{\"categories\":[\"grid\"],\"patternName\":\"dstheme/layout-p237-v5\",\"name\":\"SBS Layout p237 v5\"}} -->\n<!-- wp:ds-blocks/ds-columns {\"gap\":\"12%\",\"count\":2,\"verticalAlign\":\"start\",\"desktopColumnsPerRow\":2,\"borderRadius\":\"default\"} -->\n<!-- wp:ds-blocks/ds-column {\"style\":{\"position\":{\"type\":\"sticky\",\"top\":\"0px\"}}} -->\n<!-- wp:ds-blocks/c-heading {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"pretitle\":\"Layout p237 v5\",\"title\":\"Why Filing Early Matters\",\"showPretitle\":true,\"showDescription\":true,\"pretitleTypography\":{\"preset\":\"default\",\"fontFamily\":\"var(u002du002ddstu002du002dpretitle-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dpretitle-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dpretitle-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dpretitle-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dpretitle-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dpretitle-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dpretitle-tt)\",\"color\":\"var(u002du002ddstu002du002dpretitle-color)\"},\"titleTypography\":{\"preset\":\"h2-style\",\"fontFamily\":\"var(u002du002ddstu002du002dh2-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dh2-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dh2-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dh2-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dh2-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dh2-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dh2-tt)\",\"tag\":\"h2\"},\"subtitleTypography\":{\"preset\":\"default\",\"lineHeight\":\"1.6\"}} -->\n<!-- wp:ds-blocks/simple-text -->\n<!-- wp:paragraph {\"placeholder\":\"Enter your text here...\"} -->\n<p>Patent rights are date-specific. Filing earlier maximizes enforceability, revenue potential, and long-term market leverage. Everything brought to market after your patent filing date, is subject to your patent.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/simple-text -->\n\n<!-- wp:ds-blocks/button-group -->\n<!-- wp:ds-blocks/c-btn {\"text\":\"Primary Button\",\"hasIcon\":false,\"iconPosition\":\"row-reverse\"} /-->\n<!-- /wp:ds-blocks/button-group -->\n<!-- /wp:ds-blocks/c-heading -->\n\n<!-- wp:ds-blocks/c-media {\"media\":{\"lazyLoad\":true,\"primaryType\":\"image\",\"imagePrimary\":{\"id\":5177,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2.jpg\",\"alt\":\"\",\"mimeType\":\"image/jpeg\",\"mediaType\":\"image\",\"size\":\"full\",\"sizes\":{\"thumbnail\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-150x150.jpg\",\"width\":150,\"height\":150},\"medium\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-300x300.jpg\",\"width\":300,\"height\":300},\"large\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-1024x1024.jpg\",\"width\":1024,\"height\":1024},\"full\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2.jpg\",\"width\":1280,\"height\":1280}},\"width\":1280,\"height\":1280},\"style\":{\"desktop\":{\"mediaRatio\":\"4x3\"}}}} /-->\n<!-- /wp:ds-blocks/ds-column -->\n\n<!-- wp:ds-blocks/ds-column -->\n<!-- wp:ds-blocks/c-cards {\"class\":\"cards-v2\",\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"columns\":1,\"columnsDesktop\":1,\"cardItemPadding\":{\"top\":\"2rem\",\"right\":\"2rem\",\"bottom\":\"2rem\",\"left\":\"2rem\"},\"bodyPadding\":{\"top\":\"2rem\",\"right\":\"0rem\",\"bottom\":\"0rem\",\"left\":\"0rem\"},\"showIcon\":true,\"iconSize\":\"5rem\",\"iconDisplay\":\"inline\",\"showMedia\":false,\"showPretitle\":false,\"titleTypography\":{\"preset\":\"\",\"color\":\"\",\"fontSize\":\"\",\"fontSizeMobile\":\"\",\"textTransform\":\"\",\"fontFamily\":\"\",\"lineHeight\":\"\",\"letterSpacing\":\"\",\"lineClamp\":\"\",\"fontWeight\":\"\"},\"textTypography\":{\"preset\":\"\",\"fontSize\":\"\",\"fontSizeMobile\":\"\",\"lineClamp\":\"\",\"color\":\"\",\"lineHeight\":\"\",\"fontWeight\":\"\"},\"taglineTypography\":{\"preset\":\"default\",\"fontSize\":\"\",\"fontSizeMobile\":\"\",\"fontWeight\":\"\",\"textTransform\":\"\",\"color\":\"var(u002du002ddstu002du002dprimary-color3)\"},\"enableBorder\":true,\"cardBorder\":{\"color\":\"var(u002du002ddstu002du002dprimary-color1)\",\"width\":\"1px\"},\"borderRadius\":\"default\",\"backgroundOverlay\":\"var(u002du002ddstu002du002dsecondary-color1)\",\"backgroundOverlayOpacity\":1,\"mediaBorderRadius\":\"default\",\"postType\":{\"post\":{\"image_show\":true,\"image_size\":\"medium\",\"title_show\":true,\"title_tag\":\"h3\",\"date_show\":true,\"reading_time_show\":false,\"excerpt_show\":true,\"button_show\":true,\"button_type\":\"link\",\"category_show\":false,\"button_text\":\"Read More\",\"is_click\":true,\"card_variant\":\"-v1\",\"template\":\"/templates/components/cards/card-posts\"}},\"classVariant\":\"cards-v2\"} -->\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":2732,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/beautiful-architecture-building.jpg\",\"alt\":\"\"},\"icon\":\"4263\",\"pretitle\":\"Public disclosure starts the clock. File before the deadline or lose the ability to patent your innovation\",\"title\":\"The one-year rule\",\"description\":\"Public disclosure starts the clock. File before the deadline or lose the ability to patent your innovation\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow1\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":2731,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/aerial-view-shanghai-overpass-night.jpg\",\"alt\":\"\"},\"icon\":\"4263\",\"title\":\"Twenty-year term\",\"description\":\"Your patent protection runs from filing date, not grant date. Plan accordingly.\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow1\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":2737,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/modern-tokyo-street-background.jpg\",\"alt\":\"\"},\"icon\":\"4263\",\"title\":\"Twenty-year term\",\"description\":\"Your patent protection runs from filing date, not grant date. Plan accordingly.\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow1\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n<!-- /wp:ds-blocks/c-cards -->\n<!-- /wp:ds-blocks/ds-column -->\n<!-- /wp:ds-blocks/ds-columns -->\n<!-- /wp:ds-blocks/dst-wrapper -->",
