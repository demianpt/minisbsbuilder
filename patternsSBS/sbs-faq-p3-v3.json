width\":300,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/placeholder01-300x155.jpg\",\"orientation\":\"landscape\"},\"large\":{\"height\":528,\"width\":1024,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/placeholder01-1024x528.jpg\",\"orientation\":\"landscape\"},\"full\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/01/placeholder01.jpg\",\"height\":990,\"width\":1920,\"orientation\":\"landscape\"}}},\"fixed\":false,\"focal\":{\"x\":0.5,\"y\":0.5},\"size\":\"cover\",\"width\":\"100%\",\"height\":\"100vh\",\"position\":\"\"},\"lazy\":true,\"hideMobile\":false,\"posterImage\":null,\"fetchPriority\":\"none\",\"overlayEnabled\":true,\"overlay\":\"linear-gradient(180deg,rgba(255,255,255,0) 0%,rgb(0,0,0) 89%)\",\"overlayOpacity\":1,\"custom\":true}],\"backgroundOverlayEnabled\":true,\"backgroundOverlay\":\"#33333354\",\"metadata\":{\"categories\":[\"accordions-faq\"],\"patternName\":\"core/block/2752\",\"name\":\"SBS FAQ p3 v3\"},\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<!-- wp:ds-blocks/c-accordion {\"separator\":true,\"showQuestionIcons\":true,\"questionIconSize\":\"4rem\",\"questionStyles\":{\"padding\":\"2rem 2rem 2rem 0rem\",\"color\":\"var(u002du002ddstu002du002dsecondary-color3)\",\"activeColor\":\"var(u002du002ddstu002du002dprimary-color2)\"},\"answerStyles\":{\"padding\":\"2rem 2rem 2rem 6rem\",\"color\":\"var(u002du002ddstu002du002dsecondary-color3)\"},\"answerTypography\":{\"preset\":\"default\",\"fontSize\":\"var(u002du002ddstu002du002dbase-text-size)\",\"fontSizeMobile\":\"11px\",\"lineHeight\":\"1.6\"},\"separatorBorder\":{\"color\":\"var(u002du002ddstu002du002dsecondary-color1)\"},\"showHeader\":true} -->\n<!-- wp:ds-blocks/c-heading {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"pretitle\":\"SBS FAQ p3 v3\",\"title\":\"FAQ\",\"subtitle\":\"u003cbru003eLorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.\",\"showPretitle\":true,\"showSubtitle\":true,\"headingTheme\":\"inverted\",\"pretitleTypography\":{\"preset\":\"default\",\"fontFamily\":\"var(u002du002ddstu002du002dpretitle-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dpretitle-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dpretitle-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dpretitle-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dpretitle-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dpretitle-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dpretitle-tt)\",\"color\":\"var(u002du002ddstu002du002dpretitle-color)\"},\"titleTypography\":{\"preset\":\"h2-style\",\"fontFamily\":\"var(u002du002ddstu002du002dh2-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dh2-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dh2-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dh2-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dh2-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dh2-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dh2-tt)\"},\"subtitleTypography\":{\"preset\":\"default\",\"lineHeight\":\"1.6\"}} /-->\n\n<!-- wp:ds-blocks/c-accordion-item {\"title\":\"Adding Legal Legitimacy to Your Business\",\"defaultOpen\":true,\"questionIcon\":\"lib-icon-pin\"} -->\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<p class=\"has-secondary-1-color has-text-color has-link-color\">U.S. Government – A patent is a U.S. Government sanctioned Exclusive right to operate in a market space which can be obtained and enforced internationally through PCT process.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/c-accordion-item -->\n\n<!-- wp:ds-blocks/c-accordion-item {\"title\":\"Investor and Customer Confidence\",\"questionIcon\":\"lib-icon-mail\"} -->\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<p class=\"has-secondary-1-color has-text-color has-link-color\">Patents add surety to the business itself, and to the exclusive market space the business owns the rights to and is actively investing in providing long-term protection, defensibility, and measurable enterprise value.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/c-accordion-item -->\n\n<!-- wp:ds-blocks/c-accordion-item {\"title\":\"Acquisition and Partnership Value\",\"questionIcon\":\"lib-icon-calendar\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<p class=\"has-secondary-1-color has-text-color has-link-color\">Patents add surety of the business they are acquiring/partnering with, and the exclusive market space value they are acquiring or partnering with and planning for future business projections</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/c-accordion-item -->\n\n<!-- wp:ds-blocks/c-accordion-item {\"title\":\"Revenue Generation u0026amp; Cost Protection\",\"questionIcon\":\"lib-icon-clock\"} -->\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|secondary1\"}}}},\"textColor\":\"secondary1\"} -->\n<p class=\"has-secondary-1-color has-text-color has-link-color\">If you are innovating in a technology area that touches any market area in which a lot of financial investment and innovation is occurring, it is in your own best interests to invest in patents as both a revenue generation, and expense protection device.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/c-accordion-item -->\n<!-- /wp:ds-blocks/c-accordion -->\n<!-- /wp:ds-blocks/dst-wrapper -->",
