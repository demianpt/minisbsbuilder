  "content": "<!-- wp:ds-blocks/dst-wrapper {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"dsPadding\":{\"top\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"},\"bottom\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"}},\"metadata\":{\"categories\":[\"cards-grids\"],\"patternName\":\"core/block/2856\",\"name\":\"SBS Layout p518 v1\"}} -->\n<!-- wp:ds-blocks/ds-columns {\"dsPadding\":{\"top\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"},\"bottom\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"}},\"gap\":\"6rem\",\"gapTablet\":\"3rem\",\"gapMobile\":\"3rem\",\"count\":2,\"verticalAlign\":\"start\",\"desktopColumnsPerRow\":2,\"layoutVariant\":\"flex\",\"flexItemsPerRowTablet\":1,\"backgroundColor\":\"var(u002du002ddstu002du002dprimary-color1)\",\"decorations\":[{\"id\":\"187cd032-9337-4291-ad96-43fd687d51c2\",\"type\":\"blur\",\"className\":\"\",\"media\":[],\"lazy\":true,\"fetchPriority\":\"none\",\"position\":{\"desktop\":{\"x\":0.5,\"y\":0.5},\"tablet\":{\"x\":0.5,\"y\":0.5},\"mobile\":{\"x\":0.5,\"y\":0.5}},\"positionMode\":{\"desktop\":\"focal\",\"tablet\":\"focal\",\"mobile\":\"focal\"},\"offsets\":{\"desktop\":{\"top\":\"\",\"right\":\"\",\"bottom\":\"\",\"left\":\"\"},\"tablet\":{\"top\":\"\",\"right\":\"\",\"bottom\":\"\",\"left\":\"\"},\"mobile\":{\"top\":\"\",\"right\":\"\",\"bottom\":\"\",\"left\":\"\"}},\"transformOffset\":{\"desktop\":{\"x\":\"50%\",\"y\":\"50%\"},\"tablet\":{\"x\":\"50%\",\"y\":\"50%\"},\"mobile\":{\"x\":\"50%\",\"y\":\"50%\"}},\"display\":{\"desktop\":true,\"tablet\":true,\"mobile\":true},\"size\":{\"desktop\":{\"width\":\"\",\"height\":\"\"},\"tablet\":{\"width\":\"\",\"height\":\"\"},\"mobile\":{\"width\":\"\",\"height\":\"\"}},\"sizeMode\":{\"desktop\":\"none\",\"tablet\":\"none\",\"mobile\":\"none\"},\"blurBackground\":\"\",\"spots\":[{\"color\":\"#505cc759\",\"w\":\"50rem\",\"h\":\"50rem\",\"x\":\"13%\",\"y\":\"16%\"},{\"color\":\"#505cc759\",\"w\":\"50rem\",\"h\":\"50rem\",\"x\":\"86%\",\"y\":\"77%\"}],\"disableTablet\":false,\"disableMobile\":false}],\"borderRadius\":\"default\"} -->\n<!-- wp:ds-blocks/ds-column {\"style\":{\"position\":{\"type\":\"sticky\",\"top\":\"0px\"}}} -->\n<!-- wp:ds-blocks/c-heading {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"pretitle\":\"SBS Layout p518 v1\",\"title\":\"Why Filing Early Matters\",\"showPretitle\":true,\"showDescription\":true,\"headingTheme\":\"inverted\",\"pretitleTypography\":{\"preset\":\"default\",\"fontFamily\":\"var(u002du002ddstu002du002dpretitle-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dpretitle-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dpretitle-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dpretitle-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dpretitle-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dpretitle-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dpretitle-tt)\",\"color\":\"var(u002du002ddstu002du002dpretitle-color)\"},\"titleTypography\":{\"tag\":\"div\",\"fontSize\":\"var(u002du002ddstu002du002dh2-fs)\"},\"subtitleTypography\":{\"preset\":\"default\",\"lineHeight\":\"1.6\"}} -->\n<!-- wp:ds-blocks/simple-text -->\n<!-- wp:paragraph {\"placeholder\":\"Enter your text here...\"} -->\n<p>Patent rights are date-specific. Filing earlier maximizes enforceability, revenue potential, and long-term market leverage. Everything brought to market after your patent filing date, is subject to your patent.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/simple-text -->\n<!-- /wp:ds-blocks/c-heading -->\n<!-- /wp:ds-blocks/ds-column -->\n\n<!-- wp:ds-blocks/ds-column -->\n<!-- wp:ds-blocks/c-cards {\"class\":\"cards-v2\",\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"columns\":1,\"columnsDesktop\":1,\"gapVertical\":\"2rem\",\"gapHorizontal\":\"2rem\",\"cardItemPadding\":{\"top\":\"2rem\",\"right\":\"2rem\",\"bottom\":\"2rem\",\"left\":\"2rem\"},\"bodyPadding\":{\"top\":\"4rem\",\"right\":\"0rem\",\"bottom\":\"0rem\",\"left\":\"0rem\"},\"iconSize\":\"5rem\",\"iconDisplay\":\"inline\",\"showPretitle\":false,\"textTypography\":{\"preset\":\"default\",\"lineClamp\":\"4\"},\"taglineTypography\":{\"preset\":\"default\",\"fontSize\":\"\",\"fontSizeMobile\":\"\",\"fontWeight\":\"\",\"textTransform\":\"\",\"color\":\"var(u002du002ddstu002du002dprimary-color3)\"},\"enableBorder\":true,\"cardBorder\":{\"color\":\"var(u002du002ddstu002du002dsecondary-color1)\",\"width\":\"1px\"},\"borderRadius\":\"default\",\"backgroundOverlayEnabled\":true,\"backgroundOverlay\":\"var(u002du002ddstu002du002dsecondary-color1)\",\"backgroundOverlayOpacity\":1,\"postType\":{\"post\":{\"image_show\":true,\"image_size\":\"medium\",\"title_show\":true,\"title_tag\":\"h3\",\"date_show\":true,\"reading_time_show\":false,\"excerpt_show\":true,\"button_show\":true,\"button_type\":\"link\",\"category_show\":false,\"button_text\":\"Read More\",\"is_click\":true,\"card_variant\":\"-v1\",\"template\":\"/templates/components/cards/card-posts\"}},\"classVariant\":\"cards-v2\"} -->\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":5177,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2.jpg\",\"alt\":\"\",\"mimeType\":\"image/jpeg\",\"mediaType\":\"image\",\"size\":\"full\",\"sizes\":{\"thumbnail\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-150x150.jpg\",\"width\":150,\"height\":150},\"medium\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-300x300.jpg\",\"width\":300,\"height\":300},\"large\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2-1024x1024.jpg\",\"width\":1024,\"height\":1024},\"full\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2026/03/case-2.jpg\",\"width\":1280,\"height\":1280}},\"width\":1280,\"height\":1280},\"icon\":\"lib-icon-calendar\",\"pretitle\":\"Public disclosure starts the clock. File before the deadline or lose the ability to patent your innovation\",\"title\":\"The one-year rule\",\"description\":\"Public disclosure starts the clock. File before the deadline or lose the ability to patent your innovation\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow1\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":5117,\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2025/10/testimonial-5.jpg\",\"alt\":\"\",\"mimeType\":\"image/jpeg\",\"mediaType\":\"image\",\"size\":\"full\",\"sizes\":{\"thumbnail\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2025/10/testimonial-5-150x150.jpg\",\"width\":150,\"height\":150},\"medium\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2025/10/testimonial-5-300x169.jpg\",\"width\":300,\"height\":169},\"large\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2025/10/testimonial-5-1024x576.jpg\",\"width\":1024,\"height\":576},\"full\":{\"url\":\"https://dst.dsstaging1.com/wp-content/uploads/2025/10/testimonial-5.jpg\",\"width\":1280,\"height\":720}},\"width\":1280,\"height\":720},\"icon\":\"lib-icon-clock\",\"title\":\"Twenty-year term\",\"description\":\"Your patent protection runs from filing date, not grant date. Plan accordingly.\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow1\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n<!-- /wp:ds-blocks/c-cards -->\n<!-- /wp:ds-blocks/ds-column -->\n<!-- /wp:ds-blocks/ds-columns -->\n<!-- /wp:ds-blocks/dst-wrapper -->",
