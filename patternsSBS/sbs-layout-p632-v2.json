yPadding\":{\"top\":\"6rem\",\"right\":\"0rem\",\"bottom\":\"0rem\",\"left\":\"0rem\"},\"showIcon\":true,\"iconSize\":\"50px\",\"iconColor\":\"var(u002du002ddstu002du002dsecondary-color3)\",\"iconDisplay\":\"inline\",\"showMedia\":false,\"showPretitle\":false,\"mediaRatioDesktopCustom1\":1,\"mediaRatioDesktopCustom2\":1.1,\"textTypography\":[],\"taglineTypography\":{\"preset\":\"default\",\"fontSizeMobile\":\"\",\"fontWeight\":\"\",\"textTransform\":\"\",\"color\":\"\"},\"enableBorder\":true,\"cardBorder\":{\"color\":\"var(u002du002ddstu002du002dsecondary-color1)\",\"width\":\"1px\"},\"borderRadius\":\"default\",\"backgroundOverlayEnabled\":true,\"backgroundOverlay\":\"#33333342\",\"backgroundOverlayOpacity\":0.22,\"mediaOverlayEnabled\":true,\"mediaOverlay\":\"linear-gradient(180deg,rgba(255,255,255,0) 0%,rgb(27,44,92) 100%)\",\"mediaBgVAlign\":\"bottom\",\"cardsTheme\":\"inverted\",\"postType\":{\"post\":{\"image_show\":true,\"image_size\":\"medium\",\"title_show\":true,\"title_tag\":\"h3\",\"date_show\":true,\"reading_time_show\":false,\"excerpt_show\":true,\"button_show\":true,\"button_type\":\"link\",\"category_show\":false,\"button_text\":\"Read More\",\"is_click\":true,\"card_variant\":\"-v2\",\"template\":\"/templates/components/cards/card-posts\"}},\"metadata\":{\"patternName\":\"core/block/2470\",\"name\":\"Card v2\"}} -->\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":2983,\"url\":\"https://dst-dev.dsstaging1.local/wp-content/uploads/2026/01/Rectangle-49.jpg\",\"alt\":\"\"},\"icon\":\"1801\",\"title\":\"Card title\",\"description\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros.\",\"button\":{\"hasIcon\":true,\"iconValue\":\"lib-icon-arrow4\",\"iconReversed\":false,\"iconPosition\":\"row\",\"text\":\"Read More\",\"btnType\":\"link\"}} /-->\n\n<!-- wp:ds-blocks/c-card-item {\"media\":{\"id\":2986,\"url\":\"https://dst-dev.dsstaging1.local/wp-content/uploads/2026/01/Rectangle-57.jpg\",\"alt\":\"\"},\"icon\":\"1