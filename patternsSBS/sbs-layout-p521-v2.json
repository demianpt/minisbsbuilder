  "content": "<!-- wp:ds-blocks/dst-wrapper {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"dsPadding\":{\"top\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"},\"bottom\":{\"type\":\"default\",\"desktop\":\"\",\"mobile\":\"\"}},\"metadata\":{\"categories\":[\"grid\"],\"patternName\":\"dstheme/layout-p521-v2\",\"name\":\"SBS Layout p521 v2\"}} -->\n<!-- wp:ds-blocks/ds-columns {\"gap\":\"6rem\",\"gapTablet\":\"3rem\",\"gapMobile\":\"3rem\",\"count\":2,\"verticalAlign\":\"start\",\"desktopColumnsPerRow\":2,\"layoutVariant\":\"flex\",\"flexItemsPerRowTablet\":1,\"flexItemsPerRowMobile\":1,\"borderRadius\":\"default\"} -->\n<!-- wp:ds-blocks/ds-column {\"style\":{\"position\":{\"type\":\"sticky\",\"top\":\"0px\"}}} -->\n<!-- wp:ds-blocks/c-heading {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"pretitle\":\"Layout p521 v2\",\"title\":\"Why Filing Early Matters\",\"description\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur cursus nunc in sollicitudin interdum. Vivamus sollicitudin congue massa, ac condimentum justo gravida in. Curabitur sit amet aliquet velit. \",\"showPretitle\":true,\"showDescription\":true,\"showButtons\":true,\"showText\":true,\"pretitleTypography\":{\"preset\":\"default\",\"fontFamily\":\"var(u002du002ddstu002du002dpretitle-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dpretitle-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dpretitle-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dpretitle-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dpretitle-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dpretitle-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dpretitle-tt)\",\"color\":\"var(u002du002ddstu002du002dpretitle-color)\"},\"titleTypography\":{\"preset\":\"h2-style\",\"fontFamily\":\"var(u002du002ddstu002du002dh2-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dh2-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dh2-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dh2-lh)\",\"letterS