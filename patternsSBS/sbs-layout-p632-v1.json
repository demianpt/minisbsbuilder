etitle-color)\"},\"titleTypography\":{\"preset\":\"h2-style\",\"fontFamily\":\"var(u002du002ddstu002du002dh2-ff)\",\"fontSize\":\"var(u002du002ddstu002du002dh2-fs)\",\"fontSizeMobile\":\"var(u002du002ddstu002du002dh2-fsM)\",\"lineHeight\":\"var(u002du002ddstu002du002dh2-lh)\",\"letterSpacing\":\"var(u002du002ddstu002du002dh2-ls)\",\"fontWeight\":\"var(u002du002ddstu002du002dh2-fw)\",\"textTransform\":\"var(u002du002ddstu002du002dh2-tt)\",\"tag\":\"div\"},\"subtitleTypography\":{\"preset\":\"default\",\"lineHeight\":\"1.6\"}} -->\n<!-- wp:ds-blocks/simple-text -->\n<!-- wp:paragraph {\"placeholder\":\"Enter your text here...\"} -->\n<p>Patent rights are date-specific. Filing earlier maximizes enforceability, revenue potential, and long-term market leverage. Everything brought to market after your patent filing date, is subject to your patent.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:ds-blocks/simple-text -->\n\n<!-- wp:ds-blocks/button-group {\"dsPadding\":{\"top\":{\"type\":\"small\",\"desktop\":\"\",\"mobile\":\"\"},\"bottom\":{\"type\":\"none\",\"desktop\":\"\",\"mobile\":\"\"}}} -->\n<!-- wp:ds-blocks/c-btn {\"text\":\"Primary Button\",\"hasIcon\":false,\"iconPosition\":\"row-reverse\"} /-->\n<!-- /wp:ds-blocks/button-group -->\n<!-- /wp:ds-blocks/c-heading -->\n<!-- /wp:ds-blocks/ds-column -->\n\n<!-- wp:ds-blocks/ds-column -->\n<!-- wp:ds-blocks/c-cards {\"dsContainer\":\"\",\"dsContainerSideGap\":false,\"columns\":1,\"columnsDesktop\":1,\"cardItemPadding\":{\"top\":\"0rem\",\"right\":\"0rem\",\"bottom\":\"0rem\",\"left\":\"0rem\"},\"bodyPadding\":{\"top\":\"2rem\",\"right\":\"2rem\",\"bottom\":\"2rem\",\"left\":\"2rem\"},\"iconSize\":\"50px\",\"iconDisplay\":\"inline\",\"showPretitle\":false,\"mediaRatioDesktopCustom1\":1,\"mediaRatioDesktopCustom2\":1.1,\"textTypography\":[],\"taglineTypography\":{\"preset\":\"default\",\"fontSizeMobile\":\"\",\"fontWeight\":\"\",\"textTransform\":\"\",\"color\":\"\"},\"enableBorder\":true,\"cardBorder\":{\"color\":\"var(u002du0