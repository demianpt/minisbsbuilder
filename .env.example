# Copy to `.env` and fill in the credentials. `npm run check:env` reports what is
# configured without printing a single secret value.
#
# The server reads these values. Never use VITE_ prefixes for credentials —
# anything prefixed VITE_ is compiled into the browser bundle and is public.
HOST=127.0.0.1
PORT=4174
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Ollama is the only AI provider. One model performs all three Brief Brain jobs:
# reading the project brief, writing the page content, and mapping a typed page
# outline onto registered DST sections.
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_MS=180000

# Per-job answer budgets. Drafting a whole page needs far more room than reading
# a brief, and a truncated answer fails validation and wastes the whole call.
BRIEF_BRAIN_UNDERSTAND_TOKENS=1024
BRIEF_BRAIN_CONTENT_TOKENS=4096
BRIEF_BRAIN_OUTLINE_TOKENS=1024
# Three complete concepts plus a readback and three flows.
BRIEF_BRAIN_CONCEPT_TOKENS=3072

# One repair attempt is allowed when the model answers off-contract.
BRIEF_BRAIN_AI_ATTEMPTS=2
BRIEF_BRAIN_RATE_LIMIT_WINDOW_MS=60000
BRIEF_BRAIN_RATE_LIMIT_MAX=30
BRIEF_BRAIN_CACHE_TTL_SECONDS=3600

# ── Stock imagery (Shutterstock) ───────────────────────────────────────────────
# Search only. The server never calls a licensing endpoint, so every asset it
# returns is a WATERMARKED PREVIEW and no download is spent from a subscription.
# Either credential works. Try the API token first; fall back to the client
# id + secret pair if your account issues those instead.
SHUTTERSTOCK_API_TOKEN=
SHUTTERSTOCK_CLIENT_ID=
SHUTTERSTOCK_CLIENT_SECRET=

# Recorded for traceability only — search does not use it.
SHUTTERSTOCK_SUBSCRIPTION_ID=

# How many previews one search returns. Ten stills and two clips is enough for a
# full page without repeating a picture.
BRIEF_BRAIN_MEDIA_IMAGES=10
BRIEF_BRAIN_MEDIA_VIDEOS=2
BRIEF_BRAIN_MEDIA_TOKENS=2048
SHUTTERSTOCK_SAFE_SEARCH=true
SHUTTERSTOCK_TIMEOUT_MS=20000

# ── Also read, and not set above ───────────────────────────────────────────────
# Every one of these already works at the default shown. They are listed because
# the server reads them, so an operator never has to open `server/config.mjs` to
# find out what exists.
#
# Out-of-range values are ignored rather than rejected: a number outside the
# range shown silently reverts to the default instead of failing at boot, which
# otherwise looks like "my setting did nothing".

# Express `trust proxy`. Leave unset locally. Behind a reverse proxy set it to
# `loopback` (proxy on the same host) or a hop count, or every visitor shares one
# rate-limit bucket keyed to the proxy's own address.
# TRUST_PROXY=

# Largest JSON body the API accepts. A brief can be a whole discovery document.
# Raise nginx's client_max_body_size to match, or nginx rejects first with a 413.
# BRIEF_BRAIN_BODY_LIMIT=128kb

# The model's own per-call token ceiling, under the per-job budgets above.
# OLLAMA_NUM_PREDICT=1024                 # range 256-8192

# The older name for OLLAMA_TIMEOUT_MS, still read so a legacy env file keeps
# working. Set one or the other, never both — OLLAMA_TIMEOUT_MS wins.
# BRIEF_BRAIN_TIMEOUT_MS=

# The Shutterstock API root. Note the `/v2`: dropping it breaks search.
# SHUTTERSTOCK_BASE_URL=https://api.shutterstock.com/v2

# The cache lifetime in milliseconds instead of seconds. If both are set, this
# one wins.
# BRIEF_BRAIN_CACHE_TTL_MS=

# Accepted ranges for the values set above, for when one needs changing:
#   PORT                              1-65535
#   OLLAMA_TIMEOUT_MS                 5000-300000
#   BRIEF_BRAIN_UNDERSTAND_TOKENS     256-8192
#   BRIEF_BRAIN_CONTENT_TOKENS        512-8192
#   BRIEF_BRAIN_OUTLINE_TOKENS        256-8192
#   BRIEF_BRAIN_CONCEPT_TOKENS        512-8192
#   BRIEF_BRAIN_MEDIA_TOKENS          512-8192
#   BRIEF_BRAIN_AI_ATTEMPTS           1-3
#   BRIEF_BRAIN_RATE_LIMIT_WINDOW_MS  1000-3600000
#   BRIEF_BRAIN_RATE_LIMIT_MAX        1-200
#   BRIEF_BRAIN_CACHE_TTL_SECONDS     0-604800
#   BRIEF_BRAIN_MEDIA_IMAGES          1-40
#   BRIEF_BRAIN_MEDIA_VIDEOS          0-10
#   SHUTTERSTOCK_TIMEOUT_MS           2000-120000

# ── Development and test helpers ───────────────────────────────────────────────
# Read by scripts, not by the server. Nothing here belongs in a deployed
# environment file.
# SBS_DEV_PORT=5173                       # the port `npm run free:port` reclaims
# SBS_URL=http://127.0.0.1:5173           # where `npm run record:wordpress` loads
# HEALTH_URL=                             # base URL `npm run check:health` probes
