# ---------------------------------------------------------------------------
# minisbsbuilder.dsstaging4.com — server environment
#
# Copy to the deploy target as `.env` (or pass with `--env-file`), fill in the
# two credentials, then verify with `npm run check:env` before starting.
# Never commit the filled-in file: it holds live API keys.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Bind. 0.0.0.0 is required behind nginx or inside a container — the server
# defaults to loopback, which is unreachable from anywhere but the app itself.
HOST=0.0.0.0
PORT=4174

# The exact public origin, scheme included, with no path and no trailing slash.
# This is enforced, not cosmetic: the API rejects any browser POST whose Origin
# header does not match it, and browsers send Origin on same-origin POSTs too.
# A wrong value here loads the page fine and fails every AI action with 403.
PUBLIC_APP_ORIGIN=https://minisbsbuilder.dsstaging4.com

# Express `trust proxy`. Use `loopback` when nginx runs on the same host, a hop
# count when there are more proxies in front. Left unset, every visitor shares
# one rate-limit bucket keyed to the proxy's own address.
TRUST_PROXY=loopback

# --- AI provider (Ollama Cloud) --------------------------------------------
# Without a key the builder still works end to end: every AI job falls back to
# the deterministic built-in planner and the UI says so.
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_MS=180000

# --- Stock imagery (Shutterstock) ------------------------------------------
# Search only. The server never calls a licensing endpoint, so every asset it
# returns is a watermarked preview and no credit is ever spent.
# Either an API token, or a client id + secret pair.
SHUTTERSTOCK_API_TOKEN=
# SHUTTERSTOCK_CLIENT_ID=
# SHUTTERSTOCK_CLIENT_SECRET=

# --- Limits ----------------------------------------------------------------
# Per-client budget for AI jobs. Raise for a shared demo box where a whole team
# clicks through concepts in the same minute.
BRIEF_BRAIN_RATE_LIMIT_WINDOW_MS=60000
BRIEF_BRAIN_RATE_LIMIT_MAX=30
BRIEF_BRAIN_CACHE_TTL_SECONDS=3600
